# .env.example
#
# Copy this file to .env (same directory, repo root) and fill in every
# value below, then run:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# NEVER commit the real .env file to git.

# --- Postgres ---
# Credentials for the postgres container created by docker-compose.prod.yml.
# Pick any values -- this is a fresh container-managed database, not an
# existing one you need to match.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- kidney-backend ---
# JWT signing secret. Generate a real one with: openssl rand -hex 32
SECRET_KEY=

# Comma-separated list of allowed CORS origins (scheme + host + port, no
# trailing slash) -- must include wherever a browser will load
# kidney-frontend from. For the default kidney-frontend port mapping
# (3000:80) that's http://localhost:3000. Add a LAN IP
# (e.g. http://192.168.1.20:3000) too if demoing to other devices on the
# same network.
CORS_ORIGINS=

# --- Shared between kidney-backend and ocr-service ---
# Any value works -- it just has to match between the two services (both
# read this same variable). Generate one with: openssl rand -hex 32
OCR_SERVICE_API_KEY=

# --- kidney-frontend ---
# Baked into the frontend's static build at image-build time (Vite env vars
# are compile-time, not runtime) -- this is the URL a browser will use to
# reach kidney-backend, i.e. http://<host>:8000 for the default backend
# port mapping. Use the same host/IP you put in CORS_ORIGINS above.
VITE_API_BASE_URL=
