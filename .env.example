# .env.example
#
# Copy this file to .env (same directory, repo root) and fill in every
# value below, then run:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# NEVER commit the real .env file to git.

# --- Postgres ---
# Credentials for the postgres container created by docker-compose.prod.yml.
# Pick any values -- this is a fresh container-managed database, not an
# existing one you need to match.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- caddy (TLS reverse proxy, B9 / Phase 3.1 -- see the repo-root
# Caddyfile and docker-compose.prod.yml's own TLS note) ---
# A real domain you control, with an A/AAAA record pointing at this host's
# public IP, AND a second record for "api.<this domain>" (e.g. if DOMAIN is
# kidney.example.org, api.kidney.example.org needs its own DNS record too --
# see the Caddyfile for why kidney-backend gets its own subdomain rather
# than sharing an origin with kidney-frontend). No scheme, no path, no
# trailing slash -- just the domain.
DOMAIN=
# Contact address Let's Encrypt uses for certificate-problem notices (e.g.
# renewal starting to fail). Not required for certificates to work, but
# skipping it means nobody finds out if renewal breaks until it's already
# expired.
ACME_EMAIL=

# --- kidney-backend ---
# JWT signing secret. Generate a real one with: openssl rand -hex 32
SECRET_KEY=

# Comma-separated list of allowed CORS origins (scheme + host, no trailing
# slash) -- must include wherever a browser will load kidney-frontend from.
# With caddy in front, that's the HTTPS origin at DOMAIN above, e.g.
# "https://kidney.example.org". Add a second origin here only if doctors
# also reach the app some other way (there normally shouldn't be one, now
# that caddy is the only public entrypoint).
CORS_ORIGINS=

# --- Shared between kidney-backend and ocr-service ---
# Any value works -- it just has to match between the two services (both
# read this same variable). Generate one with: openssl rand -hex 32
OCR_SERVICE_API_KEY=

# --- kidney-frontend ---
# Baked into the frontend's static build at image-build time (Vite env vars
# are compile-time, not runtime) -- this is the URL a browser will use to
# reach kidney-backend. With caddy in front, that's the api. subdomain over
# HTTPS, e.g. "https://api.kidney.example.org" (matches DOMAIN above, with
# "api." prepended and the scheme changed to https).
VITE_API_BASE_URL=
